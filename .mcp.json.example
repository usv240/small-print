{
  "mcpServers": {
    "aws-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws-cli@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--profile",
        "small-print-agent",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "env": {
        "AWS_MCP_PROXY_PROFILES": "small-print-agent",
        "AWS_PROFILE": "small-print-agent"
      }
    }
  }
}